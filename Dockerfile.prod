# Stage 1: Build Frontend
FROM node:20 as frontend-build
WORKDIR /app
COPY frontend/package*.json ./
# Install dependencies including devDependencies for build
RUN npm install --legacy-peer-deps
COPY frontend/ .
# Build Angular app for production
RUN npm run build -- --configuration production

# Stage 2: Build Backend
FROM node:20 as backend-build
WORKDIR /app
COPY backend/package*.json ./
RUN npm install
COPY backend/ .
# Build TypeScript backend
RUN npm run build

# Stage 3: Production Image
FROM node:20-slim
WORKDIR /app

# Install production dependencies only for backend
COPY backend/package*.json ./
RUN npm install --omit=dev

# Copy built backend
COPY --from=backend-build /app/dist ./dist
# Copy routes.json if exists and needed (check if it's in src or root)
# The docker-compose.yml mapped ./backend/routes.json:/app/routes.json
# Assuming it's a static file in backend root
COPY backend/routes.json ./

# Create uploads directory
RUN mkdir -p uploads

# Copy built frontend to public folder (backend serves ../public relative to dist/app.js?)
# If backend is running from /app/dist/app.js, __dirname is /app/dist
# It looks for path.join(__dirname, '../public') -> /app/public
# So we place frontend build in /app/public
COPY --from=frontend-build /app/dist/ifesx-frontend ./public

# Copy swagger file if it's not compiled into dist (usually distinct)
# Check swagger config location... usually imported.
# But if it reads a file, we might need it. assuming compiled TS includes it or it's code.

# Environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Expose port
EXPOSE 3000

# Start command
CMD ["node", "dist/app.js"]
